#!/usr/bin/env python3
"""
SoundThis CLI — Control and run SoundThis audio streaming server for Omarchy.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request
import urllib.error

DEFAULT_PORT = 9697
BASE_DIR = os.path.dirname(os.path.abspath(__file__))

def get_status(port=DEFAULT_PORT):
    try:
        url = f"http://127.0.0.1:{port}/api/status"
        req = urllib.request.Request(url)
        with urllib.request.urlopen(req, timeout=2) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None

def post_action(action, port=DEFAULT_PORT):
    try:
        url = f"http://127.0.0.1:{port}/api/{action}"
        req = urllib.request.Request(url, data=b"", method="POST")
        with urllib.request.urlopen(req, timeout=2) as resp:
            return json.loads(resp.read().decode())
    except Exception as e:
        print(f"Error communicating with SoundThis server: {e}", file=sys.stderr)
        return None

def cmd_status(args):
    status = get_status(args.port)
    if not status:
        print(f"SoundThis server is NOT running on port {args.port}.")
        sys.exit(1)

    state = "ENABLED" if status.get("enabled") else "DISABLED"
    lan_ip = status.get("lan_ip", "127.0.0.1")
    port = status.get("port", args.port)
    clients = status.get("clients", [])

    print("=" * 45)
    print("           SoundThis Server Status")
    print("=" * 45)
    print(f"  State:          {state}")
    print(f"  Capturing:      {'YES' if status.get('capturing') else 'NO'}")
    print(f"  Local Web UI:   http://localhost:{port}")
    print(f"  LAN Web UI:     http://{lan_ip}:{port}")
    print(f"  Active Clients: {len(clients)}")
    if clients:
        print("\n  Connected Listeners:")
        for idx, c in enumerate(clients, 1):
            name = c.get("name", "Unnamed")
            ip = c.get("ip", "unknown")
            uptime = c.get("uptime", 0)
            print(f"   {idx}. {name} ({ip}) - {uptime}s")
    print("=" * 45)

def cmd_enable(args):
    res = post_action("enable", args.port)
    if res:
        print(f"SoundThis audio sharing: ENABLED")
    else:
        sys.exit(1)

def cmd_disable(args):
    res = post_action("disable", args.port)
    if res:
        print(f"SoundThis audio sharing: DISABLED")
    else:
        sys.exit(1)

def cmd_toggle(args):
    res = post_action("toggle", args.port)
    if res:
        state = "ENABLED" if res.get("enabled") else "DISABLED"
        print(f"SoundThis audio sharing is now: {state}")
    else:
        sys.exit(1)

def cmd_open(args):
    status = get_status(args.port)
    port = status.get("port", args.port) if status else args.port
    ip = status.get("lan_ip", "localhost") if status else "localhost"
    url = f"http://{ip}:{port}"
    print(f"Opening {url} in browser...")
    subprocess.run(["xdg-open", url])

def find_server_script():
    candidates = [
        os.path.join(BASE_DIR, "server.py"),
        os.path.expanduser("~/.local/share/soundthis/server.py"),
        "/home/rvs/dev/soundthis/server.py"
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    return os.path.join(BASE_DIR, "server.py")

def cmd_serve(args):
    server_script = find_server_script()
    cmd = [sys.executable, server_script, "--port", str(args.port), "--host", args.host]
    if args.disabled:
        cmd.append("--disabled")
    try:
        subprocess.run(cmd)
    except KeyboardInterrupt:
        pass

def cmd_install(args):
    install_script = os.path.join(BASE_DIR, "install.sh")
    if os.path.isfile(install_script):
        subprocess.run(["bash", install_script])
    else:
        print("install.sh not found!", file=sys.stderr)
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="SoundThis CLI")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help="Port (default 9697)")

    subparsers = parser.add_subparsers(dest="command")

    # serve
    p_serve = subparsers.add_parser("serve", help="Run the streaming server")
    p_serve.add_argument("--host", default="0.0.0.0", help="Host address")
    p_serve.add_argument("--disabled", action="store_true", help="Start disabled")

    # status
    subparsers.add_parser("status", help="Get server status")

    # enable / disable / toggle
    subparsers.add_parser("enable", help="Enable audio sharing")
    subparsers.add_parser("disable", help="Disable audio sharing")
    subparsers.add_parser("toggle", help="Toggle audio sharing")

    # open
    subparsers.add_parser("open", help="Open web client in browser")

    # install
    subparsers.add_parser("install", help="Install Omarchy plugin")

    args = parser.parse_args()

    if not args.command:
        # Default behavior: show status if server running, else help
        status = get_status(args.port)
        if status:
            cmd_status(args)
        else:
            parser.print_help()
        return

    commands = {
        "serve": cmd_serve,
        "status": cmd_status,
        "enable": cmd_enable,
        "disable": cmd_disable,
        "toggle": cmd_toggle,
        "open": cmd_open,
        "install": cmd_install
    }

    cmd_fn = commands.get(args.command)
    if cmd_fn:
        cmd_fn(args)

if __name__ == "__main__":
    main()
