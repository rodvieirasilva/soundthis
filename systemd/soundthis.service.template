[Unit]
Description=SoundThis - Real-time Desktop Audio Streaming Server for Omarchy
After=pipewire.service pipewire-pulse.service pulseaudio.service sound.target network.target
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%BIN_PATH% serve
Restart=always
RestartSec=2s

[Install]
WantedBy=default.target
